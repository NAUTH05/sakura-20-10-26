{
  "name": "mini-sakura-city",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mini Sakura City - an interactive 3D night diorama",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "bash scripts/build.sh",
    "preview": "vite preview",
    "start": "node server/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart sakura-city --update-env",
    "pm2:stop": "pm2 stop sakura-city",
    "pm2:logs": "pm2 logs sakura-city",
    "pm2:delete": "pm2 delete sakura-city"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.3",
    "vite": "5.4.10"
  },
  "engines": {
    "node": ">=18"
  }
}
