# ------------------------------------------------------------------
# Our Little Dream — production environment
# Copy to .env on the server and change every value below.
#   cp .env.example .env
#   openssl rand -hex 32     # use this for SESSION_SECRET
# ------------------------------------------------------------------

# Password for /admin (checked on the server only)
ADMIN_PASSWORD=change-me-please

# Signs the admin session cookie — long random string
SESSION_SECRET=change-me-to-a-long-random-string

# HTTP server
PORT=3000
HOST=0.0.0.0

# Where the JSON database and uploads live (default: .data)
# DATA_DIR=.data
